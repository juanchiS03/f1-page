---
// src/components/Garage.astro
---

<div
    class="relative flex items-center justify-center w-full min-h-screen bg-[radial-gradient(circle_at_center,var(--tw-gradient-stops))] from-zinc-900 to-black overflow-hidden font-sans"
>
    <h1
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 font-f1 text-[15vw] text-white/3 italic uppercase tracking-tighter select-none"
    >
        SHOWROOM
    </h1>

    <div
        class="absolute bottom-0 w-full h-1/2 bg-linear-to-t from-black via-black/80 to-transparent z-10 pointer-events-none"
    >
    </div>

    <div
        class="relative flex items-end justify-center w-full max-w-7xl px-10 group/garage z-20"
    >
        <div
            class="group relative -mr-26 mb-10 rotate-[5deg] transition-all duration-700 group-hover/garage:opacity-30 hover:opacity-100! hover:scale-110 hover:-translate-y-5"
        >
            <div
                class="absolute inset-0 bg-blue-600/10 blur-[100px] rounded-full group-hover:bg-blue-600/30 transition-all duration-700"
            >
            </div>

            <div
                class="absolute -top-6 left-0 w-full text-center opacity-0 group-hover:opacity-100 transition-all duration-500 group-hover:-top-6"
            >
                <p
                    class="font-f1 italic text-white drop-shadow-[0_0_10px_rgba(37,99,235,0.8)] uppercase text-xl"
                >
                    Verstappen | Perez
                </p>
            </div>

            <img
                src="/cars/red-bull.webp"
                alt="Red Bull"
                class="w-112.5 relative z-10 drop-shadow-[0_20px_30px_rgba(0,0,0,0.5)] animate-fade-right animate-duration-2000 animate-ease-out"
            />
            <img
                src="/cars/red-bull.webp"
                class="w-112.5 absolute top-[80%] left-0 scale-y-[-1] opacity-20 blur-sm pointer-events-none"
            />
        </div>

        <div
            class="group relative z-30 mb-20 transition-all duration-700 group-hover/garage:opacity-30 hover:opacity-100! hover:scale-110 hover:-translate-y-5"
        >
            <div
                class="absolute inset-0 bg-sky-400/10 blur-[120px] rounded-full group-hover:bg-sky-400/30 transition-all duration-700"
            >
            </div>

            <div
                class="absolute -top-10 left-0 w-full text-center opacity-0 group-hover:opacity-100 transition-all duration-500 group-hover:-top-12"
            >
                <p
                    class="font-f1 italic text-white drop-shadow-[0_0_15px_rgba(56,189,248,0.8)] uppercase text-2xl"
                >
                    <span class="text-sky-400">Gasly</span> | <span
                        class="text-pink-400">Ocon</span
                    >
                </p>
            </div>

            <img
                src="/cars/alpine.webp"
                alt="Alpine"
                class="w-125 relative z-10 drop-shadow-[0_30px_50px_rgba(0,0,0,0.7)] animate-fade-down animate-duration-2000 animate-ease-out animate-delay-300"
            />
            <img
                src="/cars/alpine.webp"
                class="w-125 absolute top-[90%] left-0 scale-y-[-1] opacity-10 blur-md pointer-events-none"
            />
        </div>

        <div
            class="group relative -ml-22 mb-0 rotate-[-8deg] transition-all duration-700 group-hover/garage:opacity-30 hover:opacity-100! hover:scale-110 hover:-translate-y-5"
        >
            <div
                class="absolute inset-0 bg-emerald-500/10 blur-[100px] rounded-full group-hover:bg-emerald-500/30 transition-all duration-700"
            >
            </div>

            <div
                class="absolute top-10 left-0 w-full text-center opacity-0 group-hover:opacity-100 transition-all duration-500 group-hover:top-20"
            >
                <p
                    class="font-f1 italic drop-shadow-[0_0_10px_rgba(16,185,129,0.8)] uppercase text-xl text-emerald-400"
                >
                    Alonso | Stroll
                </p>
            </div>

            <img
                src="/cars/aston-martin.webp"
                alt="Aston Martin"
                class="w-112.5 relative z-10 drop-shadow-[0_20px_30px_rgba(0,0,0,0.5)] animate-fade-left animate-duration-2000 animate-ease-out"
            />
            <img
                src="/cars/aston-martin.webp"
                class="w-112.5 absolute top-[65%] rotate-6 left-0 scale-y-[-1] opacity-15 blur-sm pointer-events-none"
            />
        </div>
    </div>

    <div
        class="absolute bottom-[-5%] left-1/2 -translate-x-1/2 w-[60%] h-37.5 bg-sky-500/10 blur-[100px] rounded-[100%] z-10"
    >
    </div>
</div>
